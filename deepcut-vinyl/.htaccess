RewriteEngine On

AddType application/wasm .wasm

# ---------------------------------------------------------------------------
# Pre-compressed wasm
# The two wasm binaries are ~14 MB raw and the server does not compress that
# MIME type on the fly, so the build emits .wasm.br / .wasm.gz next to them and
# we serve those directly. Content-Type must stay application/wasm for the
# browser to use streaming compilation.
# ---------------------------------------------------------------------------
RewriteCond %{HTTP:Accept-Encoding} br
RewriteCond %{REQUEST_FILENAME}.br -f
RewriteRule ^(.+)\.wasm$ $1.wasm.br [L]

RewriteCond %{HTTP:Accept-Encoding} gzip
RewriteCond %{REQUEST_FILENAME}.gz -f
RewriteRule ^(.+)\.wasm$ $1.wasm.gz [L]

<FilesMatch "\.wasm\.br$">
    ForceType application/wasm
    <IfModule mod_headers.c>
        Header set Content-Encoding br
        Header append Vary Accept-Encoding
    </IfModule>
</FilesMatch>
<FilesMatch "\.wasm\.gz$">
    ForceType application/wasm
    <IfModule mod_headers.c>
        Header set Content-Encoding gzip
        Header append Vary Accept-Encoding
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Content-hashed build artifacts never change under the same name.
    <FilesMatch "^[0-9a-f]{16,}\.wasm(\.br|\.gz)?$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^[0-9]+\.[0-9a-f]{8,}\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Entry points are revalidated on every visit so a deploy is picked up immediately.
    <FilesMatch "^(index\.html|404\.html|app\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Hand-edited data files must always be fresh.
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # Fonts, images and icons: cache for a week, then revalidate.
    <FilesMatch "\.(ttf|webp|jpg|jpeg|png|svg|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Product photos are also loaded by the desktop build and by previews on other origins.
    <FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Single page app: unknown paths are routed to index.html
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
